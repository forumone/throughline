    "@forumone/throughline-publishing": "workspace:*",
    "@forumone/throughline-reference-ds": "workspace:*",
    "@payloadcms/db-postgres": "^3.83.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/richtext-lexical": "^3.83.0",
    "graphql": "^16.8.1",
    "inngest": "^4.2.0",
    "next": "^16.2.4",
    "payload": "^3.83.0",
    "react": "^19.2.0",
