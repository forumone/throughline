{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": "@changesets/changelog-git",
  "commit": false,
  "fixed": [
    ["@forumone/throughline", "@forumone/throughline-design-system", "@forumone/create-throughline"]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@forumone/throughline-tsconfig",
    "@forumone/throughline-eslint-config",
    "@forumone/throughline-prettier-config"
  ],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}"
  }
}
