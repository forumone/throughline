{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // The check-block-props bin runs this package's built CLI, and a suite
    // spawns the bin, so the tests need this package's own build as well.
    "test": {
      "dependsOn": ["^build", "build"]
    }
  }
}
