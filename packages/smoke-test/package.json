{
  "name": "@forumone/throughline-smoke-test",
  "version": "0.0.2",
  "description": "End-to-end verification of the build/test/publish pipeline. Will be removed once the pipeline is proven.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
