{
  "name": "@forumone/throughline-design-contract",
  "version": "0.5.0",
  "description": "The contract every AI-ready design system satisfies to be consumable by Throughline.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lint": {
      "types": "./dist/lint.d.ts",
      "default": "./dist/lint.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "keywords": [
    "throughline",
    "design-system",
    "ai-ready",
    "payload"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/design-contract"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/design-contract#readme",
  "bugs": {
    "url": "https://github.com/forumone/throughline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@types/node": "^24.13.2",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
