{
  "name": "@forumone/throughline-workflows",
  "version": "0.6.4",
  "description": "Composable Inngest function factories and Payload cache-revalidation hooks for the Throughline framework — revalidation, scheduled publishing, approval expiration, audit fan-out, healthcheck.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache-tags": {
      "types": "./dist/cache-tags.d.ts",
      "default": "./dist/cache-tags.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "keywords": [
    "throughline",
    "payload",
    "inngest",
    "workflows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/workflows"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/workflows#readme",
  "bugs": {
    "url": "https://github.com/forumone/throughline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "inngest": "^4.0.0",
    "next": ">=15.0.0",
    "payload": "^3.89.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@forumone/throughline-core": "workspace:*",
    "@forumone/throughline-publishing": "workspace:*"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@payloadcms/db-sqlite": "^3.83.0",
    "@types/node": "^24.13.2",
    "eslint": "^10.11.0",
    "inngest": "^4.2.0",
    "next": "^16.2.4",
    "payload": "^3.83.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
