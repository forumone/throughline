{
  "name": "@forumone/throughline-forms",
  "version": "0.4.0",
  "description": "Policy-aware forms layer for the Throughline framework. Wraps Payload's Form Builder with privacy notices, consent, honeypot spam protection, IP rate limiting, a destination allowlist, and submitter confirmation. Six MCP tools for Claude-driven form management; submissions fan out to email and webhook destinations via Inngest.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "keywords": [
    "throughline",
    "payload",
    "forms",
    "form-builder",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/forms"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/forumone/throughline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@payloadcms/plugin-form-builder": "^3.0.0",
    "inngest": "^4.0.0",
    "payload": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@forumone/throughline-core": "workspace:*",
    "@forumone/throughline-email": "workspace:*",
    "@forumone/throughline-plugin-contract": "workspace:*",
    "@react-email/components": "^0.5.4",
    "@react-email/render": "^1.3.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@payloadcms/plugin-form-builder": "3.83.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.0",
    "eslint": "^9.15.0",
    "inngest": "^4.2.0",
    "payload": "^3.83.0",
    "react": "^19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
