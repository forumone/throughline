{
  "name": "@forumone/throughline-design-system-payload",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "description": "Turns a Throughline design-system manifest into Payload blocks, and those blocks back into React.",
  "exports": {
    ".": "./src/index.ts",
    "./generate": "./src/generate/index.ts",
    "./render": "./src/render/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing/index.ts"
  },
  "bin": {
    "check-block-props": "./bin/check-block-props.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "payload": "^3.89.0",
    "react": "^18.0.0 || ^19.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@forumone/throughline-design-contract": "workspace:*",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@payloadcms/ui": "^3.83.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.0",
    "eslint": "^10.11.0",
    "payload": "3.90.2",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
