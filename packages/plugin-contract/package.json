{
  "name": "@forumone/throughline-plugin-contract",
  "version": "0.2.1",
  "description": "Shared plugin and MCP contract types and the cross-plugin registry for @forumone/throughline core packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/plugin-contract"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/plugin-contract#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "payload": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@types/node": "^20.17.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0"
  }
}
