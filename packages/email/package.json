{
  "name": "@forumone/throughline-email",
  "version": "0.2.8",
  "description": "Transactional email system for the Throughline framework. Resend wrapper, themeable React Email templates, and Inngest functions that subscribe to the approval-workflow notification events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "email:preview": "email dev --dir src/templates"
  },
  "keywords": [
    "throughline",
    "payload",
    "email",
    "resend",
    "react-email"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/email"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/email#readme",
  "bugs": {
    "url": "https://github.com/forumone/throughline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "inngest": "^4.0.0",
    "payload": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@forumone/throughline-core": "workspace:*",
    "@forumone/throughline-plugin-contract": "workspace:*",
    "@react-email/components": "^0.5.4",
    "@react-email/render": "^1.3.2",
    "resend": "^6.1.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.0",
    "eslint": "^9.15.0",
    "inngest": "^4.2.0",
    "payload": "^3.83.0",
    "react": "^19.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
