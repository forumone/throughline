# --- Required ---
DATABASE_URI=postgres://user:pass@host/dbname
# Optional: a schema-owner credential used only by `pnpm migrate`, so the app
# itself can run as a role that reads and writes rows and no more. See
# apps/web/src/lib/database.ts.
# MIGRATION_DATABASE_URL=
PAYLOAD_SECRET=generate-with-openssl-rand-base64-48
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Inngest ---
# Leave blank in local dev; use the inngest dev server (npx inngest-cli dev).
# Set both in production after creating an Inngest app.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (for approval + form notification emails) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME={{projectName}}
EMAIL_REPLY_TO=

# --- Approval tokens ---
# Generate: openssl rand -base64 48
APPROVAL_TOKEN_SECRET=

# --- Forms ---
# Generate: openssl rand -base64 48
FORMS_IP_HASH_SECRET=

# --- MCP ---
# No keys here. Every Throughline tool is served on one /api/mcp by
# @payloadcms/plugin-mcp; create a key in the admin under MCP -> Payload MCP
# API Keys and give it to your MCP client, not to this file. Scheduled
# publishes run in process and need no key either.

# --- Optional: storage ---
# Vercel Blob token if deploying to Vercel; remove this and the storage
# adapter from payload.config.ts if you're using a different provider.
BLOB_READ_WRITE_TOKEN=
