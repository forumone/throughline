# Every variable marked "checked at startup" is listed in the assertEnvironment
# call at the top of apps/web/src/payload.config.ts, which reports all the
# missing or too-short ones in a single error before anything else runs. Add a
# variable there when you add one here that the site cannot start without.

# --- Required (checked at startup) ---
# The database may come from DATABASE_URI or, on Vercel + Neon, the
# integration's DATABASE_URL and friends — see apps/web/src/lib/database.ts.
DATABASE_URI=postgres://user:pass@host/dbname
# Optional: a schema-owner credential used only by `pnpm migrate`, so the app
# itself can run as a role that reads and writes rows and no more. See
# apps/web/src/lib/database.ts.
# MIGRATION_DATABASE_URL=
# 32+ characters. Generate: openssl rand -base64 48
PAYLOAD_SECRET=generate-with-openssl-rand-base64-48
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Inngest ---
# Leave blank in local dev; use the inngest dev server (npx inngest-cli dev).
# Set both in production after creating an Inngest app.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Resend (for approval + form notification emails) ---
# RESEND_API_KEY and EMAIL_FROM_ADDRESS are checked at startup (emailEnv).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@example.com
# Optional.
EMAIL_FROM_NAME={{projectName}}
EMAIL_REPLY_TO=

# --- Approval tokens (checked at startup: approvalsEnv) ---
# 32+ characters. Generate: openssl rand -base64 48
APPROVAL_TOKEN_SECRET=

# --- Forms (checked at startup: formsEnv) ---
# 32+ characters. Generate: openssl rand -base64 48
FORMS_IP_HASH_SECRET=

# --- MCP ---
# No keys here. Every Throughline tool is served on one /api/mcp by
# @payloadcms/plugin-mcp; create a key in the admin under MCP -> Payload MCP
# API Keys and give it to your MCP client, not to this file. Scheduled
# publishes run in process and need no key either.

# --- Optional: error reporting ---
# Where unhandled request errors, workflows that ran out of retries and failing
# healthchecks are POSTed as JSON (with a one-line `text`, so a Slack incoming
# webhook works as-is). A log drain, an alerting endpoint or a proxy in front of
# your error tracker. Unset: errors reach the log only, and the server says so
# at boot. Job failures are also recorded in the admin under Job Failures.
ERROR_WEBHOOK_URL=

# --- Optional: storage ---
# Vercel Blob token if deploying to Vercel; remove this and the storage
# adapter from payload.config.ts if you're using a different provider.
BLOB_READ_WRITE_TOKEN=
