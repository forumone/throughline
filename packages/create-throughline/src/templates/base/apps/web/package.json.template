{
  "name": "{{#if packageScope}}@{{packageScope}}/web{{else}}{{projectName}}-web{{/if}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next .turbo",
    "typecheck": "tsc --noEmit",
    "payload": "throughline-payload",
    "payload:reap": "throughline-payload --reap",
    "generate:types": "throughline-payload generate:types",
    "generate:importmap": "throughline-payload generate:importmap",
    "migrate": "PAYLOAD_MIGRATING=1 throughline-payload migrate",
    "migrate:create": "throughline-payload migrate:create",
    "migrate:status": "throughline-payload migrate:status",
    "migrate:snapshot": "tsx scripts/write-migration-snapshot.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:smoke:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@forumone/throughline": "^{{version_throughline}}",
    "@forumone/throughline-approvals": "^{{version_approvals}}",
    "@forumone/throughline-audit": "^{{version_audit}}",
    "@forumone/throughline-components": "^{{version_components}}",
    "@forumone/throughline-email": "^{{version_email}}",
    "@forumone/throughline-forms": "^{{version_forms}}",
    "@forumone/throughline-integrations": "^{{version_integrations}}",
    "@forumone/throughline-publishing": "^{{version_publishing}}",
    "@forumone/throughline-workflows": "^{{version_workflows}}",
    {{#if useReferenceDs}}"@forumone/throughline-design-contract": "^{{version_design_contract}}",
    "{{designSystemName}}": "workspace:*",
    {{/if}}"@payloadcms/db-postgres": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/plugin-form-builder": "^3.89.0",
    "@payloadcms/plugin-mcp": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "graphql": "^16.8.1",
    "inngest": "^4.2.0",
    "next": "^16.2.4",
    "payload": "^3.89.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
