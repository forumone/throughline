import { serve } from 'inngest/next'
import { getPayload } from 'payload'
import config, { suite } from '@/payload.config'
import { inngest } from '@/lib/inngest'
import { inngestJobs } from '@forumone/throughline/jobs/inngest'
import { createTerminalFailureHandler } from '@forumone/throughline/jobs'

const payload = await getPayload({ config })

/*
Every job the Throughline suite runs, as `throughline()` in payload.config.ts
listed them: publish revalidation, scheduled publishing and its backstop,
approval expiry, the audit echo, the healthcheck, the approval emails and each
integration's jobs. Each keeps the function id it has always had, so a run in
flight survives an upgrade.

A job that runs out of retries is logged, recorded in the `job-failures`
collection, and posted to ERROR_WEBHOOK_URL if that is set: given once, here,
and handed to every job.

Add this site's own functions to the list beside them.
*/
const jobs = inngestJobs(inngest, { onFailure: createTerminalFailureHandler({ payload }), payload })

export const { GET, POST, PUT } = serve({
  client: inngest,
  functions: [...jobs.functions(suite.jobs)],
})
