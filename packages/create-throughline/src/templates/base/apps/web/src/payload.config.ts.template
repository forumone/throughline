import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { buildConfig } from 'payload'
import type { Access, CollectionConfig } from 'payload'
import { postgresAdapter } from '@payloadcms/db-postgres'
import { lexicalEditor } from '@payloadcms/richtext-lexical'
import { assertEnvironment, createMcpToolCollector, mcpApiKeyAccess } from '@forumone/throughline'
import { auditPlugin } from '@forumone/throughline/audit'
import { createInngestClient } from '@forumone/throughline/jobs/inngest'
import { mcpPlugin } from '@payloadcms/plugin-mcp'
import { componentsPlugin } from '@forumone/throughline/components'
import { publishingPlugin } from '@forumone/throughline/publishing'
import {
  approvalsEnv,
  approvalsPlugin,
  buildActionUrl,
  generateActionToken,
} from '@forumone/throughline/approvals'
import { auditQueryPlugin } from '@forumone/throughline/audit'
import { integrationsPlugin } from '@forumone/throughline/integrations'
import { emailEnv, emailPlugin } from '@forumone/throughline/email'
import { createTagRevalidationHooks } from '@forumone/throughline/publishing'
import { cacheTags } from './lib/cache-tags'
import { jobFailuresPlugin } from '@forumone/throughline/observability'
import { databaseConnectionString } from './lib/database'
{{#if useReferenceDs}}import type { Manifest } from '@forumone/throughline-design-system/contract'
import designSystemManifest from '{{designSystemName}}/manifest' with { type: 'json' }
{{/if}}

/*
Every variable this site needs, checked once and reported together, before any
plugin runs. Without it each plugin throws on the first thing it finds, in
registration order, inside `next build`'s "Failed to collect page data" — one
missing variable per deploy, reading like a build failure.

The plugins' lists are their own declarations of what they refuse to start
without, so a requirement a plugin adds arrives here with the upgrade. Only the
site's own variables are written out. A value passed to a plugin as an option
rather than read from the environment takes that plugin's list out of this call.

Anything that loads this file — `next build`, `payload generate:types`,
`payload migrate` — needs these set. Where only parsing matters (CI's typecheck
and type generation), placeholders of the right length do; see
.github/workflows/ci.yml.
*/
assertEnvironment(
  approvalsEnv,
  emailEnv,
  {
    name: 'PAYLOAD_SECRET',
    minLength: 32,
    why: 'Signs Payload sessions and auth tokens. Generate with `openssl rand -base64 48`.',
  },
  {
    name: 'NEXT_PUBLIC_SERVER_URL',
    why:
      'The origin approval links are built against, e.g. http://localhost:3000. On a ' +
      'Vercel preview, set it to https://$VERCEL_URL.',
  },
  // Accepts several names (see lib/database.ts), so it is a check, not a name.
  () => databaseConnectionString(),
)

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

const inngest = createInngestClient({ id: '{{projectName}}' })

/*
Where every Throughline server puts its tools for `mcpPlugin`, which serves them
all on one `/api/mcp`. Each plugin declares its tools as the config is built and
binds the handlers at `onInit`; `mcpPlugin` reads this array at both moments.
Hand over `mcpTools.tools` itself — a spread or `.slice()` would hand over
something nobody fills.
*/
const mcpTools = createMcpToolCollector()

/*
Drops a Next cache tag when content changes, named by the same scheme your
cached reads use (see lib/cache-tags.ts). Give every collection and global that
a cached read renders a pair of these: afterChange and afterDelete on a
collection, afterChange on a global. Draft saves and autosave drop nothing.
*/
const revalidation = createTagRevalidationHooks({ cacheTags })

// A person in `users` with the admin role. `req.user` can also be an MCP key
// document, which has no roles and is never an admin, so the collection is
// checked first — once payload-types.ts exists, TypeScript insists on it.
const isAdmin: Access = ({ req: { user } }) =>
  user?.collection === 'users' &&
  Array.isArray(user.roles) &&
  (user.roles as unknown[]).includes('admin')

// Users collection — extend with your own fields and SSO/auth provider.
const Users: CollectionConfig = {
  slug: 'users',
  auth: true,
  admin: { useAsTitle: 'email' },
  fields: [
    { name: 'name', type: 'text' },
    {
      name: 'roles',
      type: 'select',
      hasMany: true,
      defaultValue: ['admin'],
      options: ['admin', 'editor', 'approver'],
    },
    {
      name: 'groups',
      type: 'select',
      hasMany: true,
      options: ['editorial', 'legal', 'communications', 'senior'],
    },
  ],
}

// The public site reads with nobody signed in, so a collection it renders needs
// a read rule that says yes to that. Without one, Payload's default refuses —
// and the page renders empty rather than erroring. Anonymous readers get a
// query, so they see published documents only; anybody signed in sees drafts
// too, which the admin and live preview need. `src/access/anonymousAccess.test.ts`
// holds every collection to the bucket it is listed in.
const publishedOrSignedIn: Access = ({ req: { user } }) =>
  user ? true : { _status: { equals: 'published' } }

// Example Pages collection. Replace this with your real content model;
// keep the `policy` group on collections that should require approval —
// the approvals plugin reads that field shape.
const Pages: CollectionConfig = {
  slug: 'pages',
  admin: { useAsTitle: 'title' },
  access: { read: publishedOrSignedIn },
  versions: { drafts: true },
  hooks: {
    afterChange: [revalidation.afterCollectionChange()],
    afterDelete: [revalidation.afterCollectionDelete()],
  },
  fields: [
    { name: 'title', type: 'text', required: true },
    { name: 'slug', type: 'text', required: true, unique: true },
    {
      name: 'seo',
      type: 'group',
      fields: [
        { name: 'title', type: 'text' },
        { name: 'description', type: 'textarea' },
      ],
    },
    {
      name: 'policy',
      type: 'group',
      fields: [
        { name: 'requiresApproval', type: 'checkbox', defaultValue: false },
        {
          name: 'approverGroups',
          type: 'select',
          hasMany: true,
          options: ['editorial', 'legal', 'communications', 'senior'],
        },
        { name: 'embargoedUntil', type: 'date' },
      ],
    },
    { name: 'publishedAt', type: 'date' },
    { name: 'scheduledPublishAt', type: 'date' },
  ],
}

export default buildConfig({
  admin: { user: 'users' },
  editor: lexicalEditor(),
  db: postgresAdapter({
    // See lib/database.ts: which variable wins, and why a migration refuses
    // Neon's pooled endpoint.
    pool: { connectionString: databaseConnectionString() },
    migrationDir: path.resolve(__dirname, 'migrations'),
    // Never push schema: migrations are the only way this database changes.
    // The adapter pushes whenever NODE_ENV !== 'production', which is true of
    // every script and dev server. One pointed at a shared database silently
    // syncs its schema and records a `dev` migration, and the next
    // `payload migrate` in CI then stops to ask about it — with no terminal to
    // answer — and skips the migration it was meant to apply.
    push: false,
  }),
  // MCP keys live in `payload-mcp-api-keys`, which `mcpPlugin` below brings.
  collections: [Users, Pages],
  secret: process.env.PAYLOAD_SECRET!,
  typescript: {
    outputFile: path.resolve(__dirname, 'payload-types.ts'),
  },
  plugins: [
    // Order matters twice. `auditPlugin` first: every other Throughline plugin
    // requires the audit log at init. And every tool-bearing plugin before
    // `mcpPlugin`, which reads the declared tools when the config is built — a
    // plugin registered after it gets no per-key checkbox, and its tools are
    // denied to every key with no error anywhere.
    auditPlugin({ inngest }),

    // Where a workflow that ran out of retries, or a failing healthcheck, leaves
    // a row — see the failure handlers in app/api/inngest/route.ts. Not the
    // audit log: that records who did what through an MCP tool.
    jobFailuresPlugin({}),

    componentsPlugin({
      {{#if useReferenceDs}}manifest: { type: 'object', manifest: designSystemManifest as unknown as Manifest },
      {{else}}// TODO: point at your design system manifest
      manifest: { type: 'url', url: 'https://your-design-system.example.com/manifest.json' },
      {{/if}}matching: { strategy: 'tfidf' },
      mcpTools,
    }),

    publishingPlugin({
      collections: [{ slug: 'pages' }],
      inngest,
      // Lazy-resolve approvals at call time so plugin order doesn't matter.
      approvalResolver: {
        getActiveApproval: async () => null, // TODO: wire to approvals plugin
      },
      mcpTools,
    }),

    approvalsPlugin({
      inngest,
      groups: [
        { slug: 'editorial', name: 'Editorial' },
        { slug: 'legal', name: 'Legal' },
        { slug: 'communications', name: 'Communications' },
        { slug: 'senior', name: 'Senior leadership' },
      ],
      groupResolver: {
        // TODO: replace with your actual user/group lookup (DB query, SSO, etc.)
        async resolveUsers(_groupSlugs) {
          return []
        },
      },
      mcpTools,
    }),

    auditQueryPlugin({ mcpTools }),

    emailPlugin({
      inngest,
      // TODO: replace with your real user lookups
      resolveApprover: async (_userId) => null,
      resolveRequester: async (_userId) => null,
      // Signed, and pointed at the route approvalsPlugin serves
      // (`/api/approvals/action`). The token binds one approval, one action
      // and one approver, so a link cannot be edited into a different decision.
      buildActionUrl: async ({ approvalId, action, approverId }) => {
        const secret = process.env.APPROVAL_TOKEN_SECRET
        if (!secret) throw new Error('APPROVAL_TOKEN_SECRET is required to sign approval links.')
        const token = await generateActionToken(
          { approvalId, action, approverId, issuedAt: Date.now() },
          secret,
        )
        return buildActionUrl(process.env.NEXT_PUBLIC_SERVER_URL!, token)
      },
      tokens: { brandName: '{{projectName}}' },
    }),

    integrationsPlugin({ inngest, mcpTools }),

    // Last of the tool-bearing chain. An MCP key is a credential that runs
    // every tool as the person it is bound to, so who may mint, read and
    // revoke one is an admin's call: `mcpApiKeyAccess` narrows the key
    // collection to `isAdmin`, and refuses a key principal outright.
    mcpPlugin({
      mcp: { tools: mcpTools.tools },
      overrideApiKeyCollection: mcpApiKeyAccess(isAdmin),
    }),
  ],
})
