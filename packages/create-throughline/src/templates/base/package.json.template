{
  "name": "{{projectName}}",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "{{#if useReferenceDs}}pnpm --filter \"./design-system\" build && {{/if}}turbo run dev",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "validate": "turbo run validate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  }
}
