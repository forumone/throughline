{
  "name": "@forumone/throughline",
  "version": "2.0.0",
  "description": "Throughline: an editorial platform for Payload CMS. Publishing, approvals, audit, integrations, email and jobs, with every feature reachable over MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "throughline": "./bin/throughline.mjs",
    "throughline-payload": "./bin/throughline-payload.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "default": "./dist/publishing/index.js"
    },
    "./editorial": {
      "types": "./dist/editorial/index.d.ts",
      "default": "./dist/editorial/index.js"
    },
    "./approvals": {
      "types": "./dist/approvals/index.d.ts",
      "default": "./dist/approvals/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "default": "./dist/integrations/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./jobs": {
      "types": "./dist/jobs/index.d.ts",
      "default": "./dist/jobs/index.js"
    },
    "./jobs/inngest": {
      "types": "./dist/jobs/inngest/index.d.ts",
      "default": "./dist/jobs/inngest/index.js"
    },
    "./jobs/payload": {
      "types": "./dist/jobs/payload/index.d.ts",
      "default": "./dist/jobs/payload/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cache-tags": {
      "types": "./dist/cache-tags.d.ts",
      "default": "./dist/cache-tags.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "default": "./dist/exports/rsc.js"
    }
  },
  "files": [
    "dist",
    "bin/*.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin",
    "test": "vitest run"
  },
  "keywords": [
    "throughline",
    "payload",
    "cms",
    "mcp",
    "publishing",
    "audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forumone/throughline.git",
    "directory": "packages/throughline"
  },
  "homepage": "https://github.com/forumone/throughline/tree/main/packages/throughline#readme",
  "bugs": {
    "url": "https://github.com/forumone/throughline/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/plugin-cloud-storage": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "@react-email/components": "^0.5.4",
    "@react-email/render": "^1.3.2",
    "@vercel/blob": "^2.0.0",
    "inngest": "^4.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "payload": "^3.89.0",
    "react": "^18.0.0 || ^19.0.0",
    "resend": "^6.1.4",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/next": {
      "optional": true
    },
    "@payloadcms/plugin-cloud-storage": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    },
    "@react-email/components": {
      "optional": true
    },
    "@react-email/render": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "inngest": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@forumone/throughline-design-system": "workspace:*",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@forumone/throughline-eslint-config": "workspace:*",
    "@forumone/throughline-reference-ds": "workspace:*",
    "@forumone/throughline-tsconfig": "workspace:*",
    "@payloadcms/db-sqlite": "^3.83.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/plugin-cloud-storage": "^3.83.0",
    "@payloadcms/ui": "^3.83.0",
    "@react-email/components": "^0.5.4",
    "@react-email/render": "^1.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/blob": "2.3.1",
    "eslint": "^10.11.0",
    "inngest": "^4.2.0",
    "next": "^16.2.4",
    "payload": "^3.83.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.1.4",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
